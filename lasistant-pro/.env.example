# Copiez ce fichier en « .env.local » puis adaptez les valeurs.
# Seules les variables préfixées par VITE_ sont exposées au navigateur :
# n'y placez JAMAIS de secret (clé de service, mot de passe SMTP…).

# Adresse publique du site (URL canoniques, partage, sitemap)
VITE_SITE_URL=https://lasistant.pro

# Source des données : « mock » (phase statique, données simulées dans le navigateur)
# ou « supabase » (phase 2, une fois la base de données branchée)
VITE_DATA_SOURCE=mock

# Latence simulée des écritures en mode « mock », en millisecondes (affiche les états de chargement)
VITE_MOCK_LATENCY_MS=450

# Phase 2 : connexion Supabase (clé publique « anon » uniquement côté navigateur)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

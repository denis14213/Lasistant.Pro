# Modèle de configuration. Les valeurs publiques du projet sont dans .env.production et
# .env.development (versionnés). Pour une configuration personnelle, copiez ce fichier en
# « .env.local » (jamais versionné), qui prend le pas sur les autres.
# Seules les variables préfixées par VITE_ sont exposées au navigateur : n'y placez JAMAIS de
# secret (clé secrète Supabase, service_role, mot de passe SMTP…). Les secrets vivent dans les
# Edge Functions (tableau de bord Supabase › Edge Functions › Secrets).

# Adresse publique du site (URL canoniques, partage, plan du site)
VITE_SITE_URL=https://lasistant.pro

# Source des données : « supabase » (par défaut) ou « mock » (base simulée dans le navigateur,
# réservée aux tests automatisés et au travail hors ligne)
VITE_DATA_SOURCE=supabase

# Projet Supabase : adresse et clé publique (« publishable », format sb_publishable_…)
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Latence simulée des écritures en mode « mock », en millisecondes (affiche les états de chargement)
VITE_MOCK_LATENCY_MS=450

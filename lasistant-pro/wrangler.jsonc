// Déploiement sur Cloudflare Workers : site compilé dans « dist » (npm run build), publié par
// « npm run deploy ». Les fichiers et les navigations sont servis directement par Cloudflare :
// toute adresse sans fichier correspondant reçoit index.html, et le routeur affiche la page
// (ou la page 404). Le Worker (worker/index.ts) ne traite que les autres cas : voir son en-tête.
// En-têtes HTTP : public/_headers. Domaine, variables et mise en ligne : docs/deploiement-cloudflare.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lasistant-pro",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
